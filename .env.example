# Mapbox (required for satellite imagery)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Backend
PORT=4000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (Docker)
POSTGRES_USER=hsetcl
POSTGRES_PASSWORD=hsetcl_secret
POSTGRES_DB=hsetcl_digital_twin
DATABASE_URL=postgresql://hsetcl:hsetcl_secret@localhost:5432/hsetcl_digital_twin
